{{!
    @template availability_proctor/redirect

    Bare standalone page (no Moodle chrome) that auto-submits a form
    redirecting the learner into the Proctor by Constructor WebApp.

    Context variables required for this template:
    * pagetitle - string, page <title>
    * gobuttonlabel - string, submit button label
    * action - string, form action URL
    * method - string, form method (get/post)
    * hastoken - bool, whether a hidden token input should be rendered
    * token - string, hidden token value (only used when hastoken is true)

    Example context (json):
    {
        "pagetitle": "Redirecting to Proctor by Constructor",
        "gobuttonlabel": "Go to Proctor by Constructor",
        "action": "https://proctor.example.com/entry",
        "method": "post",
        "hastoken": true,
        "token": "abc123"
    }
}}
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<title>{{pagetitle}}</title>
</head>
<body>
<div style="text-align: center">
<form action="{{action}}" method="{{method}}" id="availability_proctor_redirect_form">
{{#hastoken}}<input type="hidden" value="{{token}}" name="token">{{/hastoken}}
<button type="submit">{{gobuttonlabel}}</button>
</form>
</div>
<script type="text/javascript">
function redirect() {
    document.getElementById('availability_proctor_redirect_form').submit();
}
try { redirect() } catch (e) { console.error(e) }
setTimeout(redirect, 5000);
setTimeout(redirect, 10000);
</script>
</body>
</html>
